---
// Each feature owns a panel slot on the right. The visuals are interim
// placeholders; they get replaced one by one as each feature is designed.
const features = [
  { key: 'offline', title: 'Offline', body: 'Everything happens on your computer. Quoth downloads a model once and never needs the network again. Works on a train, on a plane, in a basement.' },
  { key: 'private', title: 'Private', body: 'Your voice and your words never leave the device. Nothing is logged, nothing is uploaded, and there is no account to make.' },
  { key: 'instant', title: 'Instant', body: 'Quoth uses your NPU or GPU when you have one and keeps the model warm, so the text lands the moment you stop talking.' },
  { key: 'open', title: 'Open source', body: 'Free software under the GPL, built on the standard Linux desktop stack. Read it, fork it, make it yours.' },
  { key: 'modes', title: 'Two modes', body: 'Tap the key to start and stop, or hold it down and talk. Whichever feels natural to you.' },
  { key: 'anyapp', title: 'Any app', body: 'Editors, browsers, chat, terminals. Whatever has focus gets the text. No plugins, no per-app setup.' },
  { key: 'translate', title: 'Translate', body: 'Speak your language and get English text, straight into the field you are typing in.' },
  { key: 'riceable', title: 'Riceable', body: 'Theme the overlay with one file. Nord, Catppuccin and Dracula come built in, and the file hot-reloads while you tweak it.' },
];
---
<section id="why" aria-labelledby="why-heading" class="mx-auto max-w-7xl px-6 py-section sm:px-8">
  <div class="mb-14 max-w-2xl" data-reveal-group>
    <p class="eyebrow mb-4 reveal">Why Quoth</p>
    <h2 id="why-heading" class="text-display font-light leading-[1.02] tracking-[-0.025em] reveal">
      Dictation that behaves like a <em class="font-medium not-italic">local tool</em>, because it is one.
    </h2>
  </div>

  <div id="features" class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)] lg:gap-16 reveal">
    <ul role="tablist" aria-label="Features" aria-orientation="vertical" class="flex flex-col gap-1 lg:sticky lg:top-24 lg:self-start">
      {features.map((f, i) => (
        <li role="presentation">
          <button
            role="tab"
            id={`tab-${f.key}`}
            aria-controls={`panel-${f.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="feature-tab group block w-full py-2.5 text-left transition-colors"
          >
            <span class="text-2xl font-light tracking-tight transition-colors group-aria-selected:font-normal">{f.title}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="min-w-0">
      {features.map((f, i) => (
        <div
          role="tabpanel"
          id={`panel-${f.key}`}
          aria-labelledby={`tab-${f.key}`}
          hidden={i !== 0}
          class="feature-panel"
        >
          <div class="flex aspect-[16/10] items-center justify-center" data-visual={f.key}>
            <!-- Interim visual: replaced per feature as each one is designed. -->
            <span class="text-6xl font-light tracking-tight text-ink-600">{f.title}</span>
          </div>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-bone-dim">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-tab { color: var(--color-ink-500); }
  .feature-tab:hover { color: var(--color-ink-300); }
  .feature-tab[aria-selected='true'] { color: var(--color-bone); }
  .feature-panel { animation: panel-in 500ms var(--ease-out-expo) both; }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .feature-panel { animation: none; }
  }
</style>

<script>
  import { mountTabs } from '../scripts/tabs';
  mountTabs(document.getElementById('features'));
</script>
