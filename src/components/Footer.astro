---
import logo from '../assets/brand/quoth-logo.svg?raw';
import { siGithub, siBuymeacoffee } from 'simple-icons';
const year = new Date().getFullYear();
const LINKEDIN = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
const links = [
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/maintainers', label: 'Maintainers' },
  { href: '/legal-notice', label: 'Legal notice' },
  { href: '/privacy', label: 'Privacy' },
  { href: 'https://github.com/abullard1/quoth/issues', label: 'Support' },
];
const socials = [
  { href: 'https://github.com/abullard1/quoth', label: 'GitHub', path: siGithub.path },
  { href: 'https://www.linkedin.com/in/samuel-bullard/', label: 'LinkedIn', path: LINKEDIN },
  { href: 'https://buymeacoffee.com/samuelbullard', label: 'Buy Me a Coffee', path: siBuymeacoffee.path },
];
---
<footer class="mx-auto max-w-7xl px-6 pb-10 pt-section sm:px-8">
  <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <span class="block h-8 w-8 text-bone [&_svg]:h-full [&_svg]:w-full [&_svg]:fill-current" set:html={logo} />
      <p class="mt-4 max-w-xs text-sm text-ink-400">Offline, private voice dictation for Linux.</p>
    </div>
    <div class="flex flex-col gap-6 sm:items-end">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-400">
        {links.map((l) => (
          <li><a class="transition-colors hover:text-bone" href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <ul class="flex gap-5">
        {socials.map((s) => (
          <li>
            <a href={s.href} rel="noopener" aria-label={s.label} class="block text-ink-400 transition-colors hover:text-bone">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="mt-10 text-xs text-ink-600">&copy; {year} Samuel Bullard. Quoth is free software, GPL-3.0-or-later.</p>
</footer>
