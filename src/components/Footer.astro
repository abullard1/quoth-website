---
import logo from '../assets/brand/quoth-logo.svg?raw';
---
<footer class="border-t hairline">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-6 py-12 sm:flex-row sm:items-end sm:justify-between sm:px-8">
    <div>
      <span class="block h-10 w-10 text-bone [&_svg]:h-full [&_svg]:w-full [&_svg]:fill-current" set:html={logo} />
      <p class="mt-4 max-w-xs text-sm text-ink-400">Offline, private, instant voice dictation for Linux.</p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-400">
      <li><a class="transition-colors hover:text-bone" href="https://github.com/abullard1/quoth" rel="noopener">GitHub</a></li>
      <li><a class="transition-colors hover:text-bone" href="https://github.com/abullard1/quoth/issues" rel="noopener">Issues</a></li>
      <li><a class="transition-colors hover:text-bone" href="https://buymeacoffee.com/samuelbullard" rel="noopener">Support</a></li>
      <li class="text-ink-600">GPL-3.0-or-later</li>
    </ul>
  </div>
</footer>
