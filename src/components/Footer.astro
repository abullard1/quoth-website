---
import logo from '../assets/brand/quoth-logo.svg?raw';
const year = new Date().getFullYear();
---
<footer class="mx-auto max-w-7xl px-6 pb-10 pt-section sm:px-8">
  <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
    <div class="flex items-center gap-4">
      <span class="block h-8 w-8 text-bone [&_svg]:h-full [&_svg]:w-full [&_svg]:fill-current" set:html={logo} />
      <p class="text-sm text-ink-400">&copy; {year} Samuel Bullard</p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-400">
      <li><a class="transition-colors hover:text-bone" href="/legal-notice">Legal notice</a></li>
      <li><a class="transition-colors hover:text-bone" href="/privacy">Privacy</a></li>
      <li><a class="transition-colors hover:text-bone" href="https://github.com/abullard1/quoth/issues" rel="noopener">Support</a></li>
    </ul>
  </div>
</footer>
