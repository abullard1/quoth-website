---
import { WifiOff, Lock, Zap, Code2, ToggleLeft, Clipboard, Languages, Palette } from 'lucide-astro';
const big = [
  { icon: WifiOff, title: 'Offline', body: 'Everything happens on your computer. Quoth downloads a model once and never needs the network again. Works on a train, on a plane, in a basement.' },
  { icon: Lock, title: 'Private', body: 'Your voice and your words never leave the device. Nothing is logged, nothing is uploaded, and there is no account to make.' },
  { icon: Zap, title: 'Instant', body: 'Quoth uses your NPU or GPU when you have one and keeps the model warm, so the text lands the moment you stop talking.' },
  { icon: Code2, title: 'Open', body: 'Free software under the GPL, built on the standard Linux desktop stack. Read it, fork it, make it yours.' },
];
const small = [
  { icon: ToggleLeft, title: 'Two modes', body: 'Tap to start and stop, or hold to talk.' },
  { icon: Clipboard, title: 'Types into any app', body: 'Editors, browsers, chat, terminals. Wherever your cursor is.' },
  { icon: Languages, title: 'Translate to English', body: 'Speak your language, get English text.' },
  { icon: Palette, title: 'Riceable', body: 'Theme the overlay with one file. Nord, Catppuccin and Dracula come built in.' },
];
---
<section id="why" aria-labelledby="why-heading" class="mx-auto max-w-7xl px-6 py-section sm:px-8">
  <div class="mb-14 max-w-2xl" data-reveal-group>
    <p class="eyebrow mb-4 reveal">Why Quoth</p>
    <h2 id="why-heading" class="text-display font-light leading-[1.02] tracking-[-0.025em] reveal">
      Dictation that behaves like a <em class="font-medium not-italic">local tool</em>, because it is one.
    </h2>
  </div>

  <div class="grid gap-4 md:grid-cols-2" data-reveal-group>
    {big.map(({ icon: Icon, title, body }) => (
      <article class="surface group rounded-2xl p-8 transition-colors reveal sm:p-10">
        <Icon size={22} stroke-width={1.5} class="text-ink-300 transition-colors group-hover:text-bone" />
        <h3 class="mt-8 text-3xl font-medium tracking-tight">{title}</h3>
        <p class="mt-3 max-w-md leading-relaxed text-bone-dim">{body}</p>
      </article>
    ))}
  </div>

  <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {small.map(({ icon: Icon, title, body }) => (
      <li class="surface rounded-2xl p-6 reveal">
        <div class="flex items-center gap-3">
          <Icon size={18} stroke-width={1.5} class="text-ink-300" />
          <h3 class="font-medium">{title}</h3>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-bone-dim">{body}</p>
      </li>
    ))}
  </ul>
</section>
