---
const steps = [
  { key: 'press', title: 'Press', body: 'Tap your hotkey, or hold it down.' },
  { key: 'speak', title: 'Speak', body: 'Say what you mean, in your language.' },
  { key: 'done', title: 'Done', body: 'It is typed exactly where your cursor is.' },
];
---
<section id="how" aria-labelledby="how-heading" class="mx-auto max-w-7xl px-6 py-section sm:px-8" data-reveal-group>
  <p class="eyebrow mb-4 reveal">How it works</p>
  <h2 id="how-heading" class="text-display font-light leading-[1.02] tracking-[-0.025em] reveal">Three beats.</h2>

  <div class="mt-14 reveal">
    <!-- One shape carries the whole story: key cap, then the Quoth pill with a
         waveform, then the caret that writes the sentence. -->
    <svg id="beats" viewBox="0 0 640 220" class="mx-auto block w-full max-w-3xl" fill="none" aria-hidden="true">
      <circle id="b-ring" cx="320" cy="110" r="52" stroke="var(--color-bone)" stroke-opacity="0" stroke-width="1.5" />
      <rect id="b-shape" x="280" y="70" width="80" height="80" rx="20" fill="var(--color-bone)" />
      <g id="b-wave" opacity="0">
        {[10, 18, 28, 22, 34, 22, 28, 18, 10].map((h, i) => (
          <rect class="b-bar" x={320 + (i - 4) * 16 - 3} y={110 - h / 2} width="6" height={h} rx="3" fill="var(--color-ink-950)" />
        ))}
      </g>
      <text id="b-text" x="120" y="119" font-size="26" font-family="inherit" fill="var(--color-bone)" letter-spacing="-0.01em" opacity="0"></text>
    </svg>
  </div>

  <ol id="beat-steps" class="mx-auto mt-10 grid max-w-4xl gap-8 sm:grid-cols-3">
    {steps.map((s) => (
      <li data-step={s.key} class="beat-step reveal flex gap-4">
        <span class="mt-0.5 shrink-0 text-bone" aria-hidden="true">
          {s.key === 'press' && (
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3.5" y="2.5" width="15" height="14" rx="4" /><path d="M6 19.5h10" stroke-linecap="round" /></svg>
          )}
          {s.key === 'speak' && (
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3.5 9v4M7.25 6v10M11 3v16M14.75 6v10M18.5 9v4" /></svg>
          )}
          {s.key === 'done' && (
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3.5 6h15M3.5 11h15M3.5 16h7" /><path d="M13.5 13.5v5" /></svg>
          )}
        </span>
        <div>
          <h3 class="text-lg font-medium tracking-tight">{s.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-bone-dim">{s.body}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .beat-step > * { transition: opacity 500ms var(--ease-out-quart); }
  .beat-step[data-active='false'] > * { opacity: 0.35; }
</style>

<script>
  import { mountBeats } from '../scripts/beats';
  mountBeats();
</script>
