---
import { Github, Coffee } from 'lucide-astro';
---
<section id="get" aria-labelledby="get-heading" class="mx-auto max-w-7xl px-6 py-section sm:px-8">
  <div class="mx-auto max-w-2xl text-center" data-reveal-group>
    <p class="eyebrow mb-4 reveal">Get Quoth</p>
    <h2 id="get-heading" class="text-display font-light leading-[1.02] tracking-[-0.025em] reveal">
      Coming to Flathub.
    </h2>
    <p class="mx-auto mt-5 max-w-md text-bone-dim reveal">
      One click install for every distro is on its way. Until then, Quoth lives on GitHub. Star it to hear the moment it ships.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3 reveal">
      <a class="btn btn-primary" aria-disabled="true" href="https://flathub.org/">Flathub, soon</a>
      <a class="btn btn-ghost" href="https://github.com/abullard1/quoth" rel="noopener"><Github size={16} stroke-width={1.75} /> GitHub</a>
      <a class="btn btn-ghost" href="https://buymeacoffee.com/samuelbullard" rel="noopener"><Coffee size={16} stroke-width={1.75} /> Buy me a coffee</a>
    </div>
  </div>
</section>
