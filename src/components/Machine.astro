---
const accel = [
  ['CPU', 'Always'],
  ['Intel NPU (Lunar Lake and newer)', 'via OpenVINO'],
  ['GPU: Intel, AMD, NVIDIA', 'via Vulkan'],
];
const compositors = [
  ['COSMIC (Pop!_OS)', 'Supported'],
  ['Sway / wlroots', 'Supported'],
  ['KDE Plasma (Wayland)', 'Supported'],
  ['GNOME (Wayland)', 'Supported, via ydotool'],
  ['X11', 'Planned'],
];
const models = [
  ['tiny', '75 MB', 'Fastest, basic accuracy'],
  ['base', '142 MB', 'Fast, good accuracy'],
  ['small', '466 MB', 'Default. Balanced'],
  ['large-v3-turbo', '1.6 GB', 'Best accuracy, needs GPU or NPU'],
];
---
<section id="machine" aria-labelledby="machine-heading" class="border-y hairline bg-ink-900/60">
  <div class="mx-auto max-w-7xl px-6 py-section sm:px-8">
    <div class="mb-14 max-w-2xl" data-reveal-group>
      <p class="eyebrow mb-4 reveal">Hardware</p>
      <h2 id="machine-heading" class="text-display font-light leading-[1.02] tracking-[-0.025em] reveal">
        Built for the machine you already own.
      </h2>
      <p class="mt-5 text-bone-dim reveal">x86_64 today. ARM64 is on the roadmap.</p>
    </div>

    <div class="grid gap-10 lg:grid-cols-3" data-reveal-group>
      <div class="reveal">
        <h3 class="eyebrow mb-4">Acceleration</h3>
        <dl class="divide-y hairline border-y hairline">
          {accel.map(([k, v]) => (
            <div class="flex items-baseline justify-between gap-4 py-3.5 text-sm">
              <dt class="text-bone">{k}</dt>
              <dd class="text-right text-ink-300">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="reveal">
        <h3 class="eyebrow mb-4">Compositors</h3>
        <dl class="divide-y hairline border-y hairline">
          {compositors.map(([k, v]) => (
            <div class="flex items-baseline justify-between gap-4 py-3.5 text-sm">
              <dt class="text-bone">{k}</dt>
              <dd class:list={['text-right', v === 'Planned' ? 'text-ink-500' : 'text-ink-300']}>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="reveal">
        <h3 class="eyebrow mb-4">Models, downloaded on demand</h3>
        <dl class="divide-y hairline border-y hairline">
          {models.map(([k, size, note]) => (
            <div class="grid grid-cols-[auto_1fr] gap-x-4 py-3.5 text-sm">
              <dt class="font-mono text-bone">{k}</dt>
              <dd class="text-right text-ink-300">{size}</dd>
              <dd class="col-span-2 text-xs text-ink-500">{note}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
