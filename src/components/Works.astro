---
import { siUbuntu, siArchlinux, siFedora, siDebian, siPopos, siLinuxmint } from 'simple-icons';
// One desktop, the pill opens on it, then it splits into six distros. Logos are
// the wallpapers. Frame coordinates are 640x400; the small frames scale to 0.3.
const distros = [siUbuntu, siArchlinux, siFedora, siDebian, siPopos, siLinuxmint];
const bars = [10, 18, 26, 20, 30, 20, 26, 18, 10];
---
<section id="works" aria-labelledby="works-heading" class="mx-auto max-w-7xl px-6 py-section sm:px-8">
  <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.3fr]" data-reveal-group>
    <div>
      <p class="eyebrow mb-4 reveal">Fits in</p>
      <h2 id="works-heading" class="text-display font-light leading-[1.02] tracking-[-0.025em] reveal">
        Made for the Linux desktop you already have.
      </h2>
    </div>
    <svg id="desktops" viewBox="0 0 640 400" class="reveal block w-full overflow-visible" fill="none" aria-hidden="true">
      <g id="dk-one">
        <rect x="0" y="0" width="640" height="400" rx="18" stroke="var(--color-bone)" stroke-opacity="0.5" />
        <rect x="0" y="0" width="640" height="26" rx="18" fill="var(--color-bone)" fill-opacity="0.14" />
        <rect x="290" y="9" width="60" height="8" rx="4" fill="var(--color-bone)" fill-opacity="0.35" />
        <!-- Outer group holds the position; GSAP animates the inner one so it never clobbers the translate. -->
        <g transform="translate(320 330)">
          <g id="dk-pill">
            <rect x="-90" y="-24" width="180" height="48" rx="24" fill="var(--color-bone)" />
            {bars.map((h, i) => (
              <rect class="dk-bar" x={(i - 4) * 14 - 2.5} y={-h / 2} width="5" height={h} rx="2.5" fill="var(--color-ink-950)" />
            ))}
          </g>
        </g>
      </g>
      {distros.map((d) => (
        <g class="dk" opacity="0">
          <rect x="0" y="0" width="640" height="400" rx="18" stroke="var(--color-bone)" stroke-opacity="0.5" stroke-width="2" />
          <rect x="0" y="0" width="640" height="26" rx="18" fill="var(--color-bone)" fill-opacity="0.14" />
          <path class="dk-logo" d={d.path} fill="var(--color-bone)" fill-opacity="0" transform="translate(248 128) scale(6)" />
          <g transform="translate(320 330)">
            <g class="dk-mini" opacity="0">
              <rect x="-90" y="-24" width="180" height="48" rx="24" fill="var(--color-bone)" />
              {bars.map((h, i) => (
                <rect x={(i - 4) * 14 - 2.5} y={-h / 2} width="5" height={h} rx="2.5" fill="var(--color-ink-950)" />
              ))}
            </g>
          </g>
        </g>
      ))}
    </svg>
  </div>
</section>

<script>
  import { mountDesktops } from '../scripts/desktops';
  mountDesktops();
</script>
