---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
export const prerender = false;
const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');
---
<Base title="Support" description="Ask a question or report a problem with Quoth. No account, no issue tracker, just a message.">
  <Nav />
  <main class="mx-auto max-w-7xl px-6 pb-section pt-40 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <div data-reveal-group>
        <p class="eyebrow mb-4 reveal">Support</p>
        <h1 class="text-display font-light leading-[1.02] tracking-[-0.025em] reveal">How can we help?</h1>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-bone-dim reveal">
          Questions, problems, ideas. Write what is on your mind and it lands in the maintainer's inbox. You will get a reply at the address you give.
        </p>
        <p class="mt-6 max-w-md text-sm text-ink-400 reveal">
          Found a bug and have logs to share? <a class="text-bone-dim underline decoration-ink-600 underline-offset-4 transition-colors hover:text-bone hover:decoration-bone" href="https://github.com/abullard1/quoth/issues" rel="noopener">GitHub issues</a> work too, but they are not required.
        </p>
      </div>

      <div class="reveal">
        {sent ? (
          <div id="support-sent" class="max-w-lg">
            <h2 class="text-2xl font-medium tracking-tight">Sent.</h2>
            <p class="mt-3 text-bone-dim">Thanks. You will hear back at the address you gave.</p>
          </div>
        ) : (
          <form id="support-form" method="post" action="/api/support" class="max-w-lg space-y-6" novalidate>
            <input type="hidden" name="started" value={String(Date.now())} />
            <!-- Honeypot: hidden from people, filled by bots. -->
            <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
              <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <div class="grid gap-6 sm:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-sm text-ink-300">Name <span class="text-ink-600">optional</span></span>
                <input name="name" type="text" maxlength="100" autocomplete="name" class="field" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm text-ink-300">Email</span>
                <input name="email" type="email" required maxlength="200" autocomplete="email" class="field" />
              </label>
            </div>
            <label class="block">
              <span class="mb-2 block text-sm text-ink-300">Message</span>
              <textarea name="message" required minlength="10" maxlength="5000" rows="7" class="field resize-y"></textarea>
            </label>
            <p id="support-error" class="min-h-5 text-sm text-[#e7a3a3]" role="alert" aria-live="polite">{error ?? ''}</p>
            <button type="submit" class="btn btn-primary">Send message</button>
          </form>
        )}
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .field {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in oklab, var(--color-bone) 14%, transparent);
    background: color-mix(in oklab, var(--color-bone) 3%, transparent);
    padding: 0.8rem 1rem;
    color: var(--color-bone);
    transition: border-color 200ms, background-color 200ms;
  }
  .field:hover { border-color: color-mix(in oklab, var(--color-bone) 24%, transparent); }
  .field:focus { outline: none; border-color: color-mix(in oklab, var(--color-bone) 50%, transparent); background: color-mix(in oklab, var(--color-bone) 5%, transparent); }
  .field:user-invalid { border-color: #e7a3a3; }
</style>

<script>
  // Progressive enhancement: submit in place, fall back to the plain POST.
  const form = document.getElementById('support-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('support-error');
  if (form && errorEl) {
    form.addEventListener('submit', async (e) => {
      if (!form.reportValidity()) { e.preventDefault(); return; }
      e.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      button.disabled = true;
      button.textContent = 'Sending';
      errorEl.textContent = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = (await res.json()) as { ok: boolean; error?: string };
        if (!data.ok) throw new Error(data.error ?? 'Something went wrong.');
        form.replaceWith(Object.assign(document.createElement('div'), {
          className: 'max-w-lg',
          innerHTML: '<h2 class="text-2xl font-medium tracking-tight">Sent.</h2><p class="mt-3 text-bone-dim">Thanks. You will hear back at the address you gave.</p>',
        }));
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong.';
        button.disabled = false;
        button.textContent = 'Send message';
      }
    });
  }
</script>
