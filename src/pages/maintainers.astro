---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { siGithub } from 'simple-icons';
const LINKEDIN = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
const people = [
  {
    name: 'Samuel Ruairí Bullard',
    role: 'Creator and maintainer',
    image: '/maintainers/samuel.jpg',
    bio: 'Started Quoth because dictation on Linux meant sending your voice to someone else\'s server. Responsible for everything so far: the whisper.cpp and NPU integration, the GTK overlay and its themes, packaging for Flathub, Arch and Debian, and this website.',
    socials: [
      { href: 'https://github.com/abullard1', label: 'GitHub', path: siGithub.path },
      { href: 'https://www.linkedin.com/in/samuel-bullard/', label: 'LinkedIn', path: LINKEDIN },
    ],
  },
];
---
<Base title="Maintainers" description="The people who build and maintain Quoth.">
  <Nav />
  <main class="mx-auto max-w-7xl px-6 pb-section pt-40 sm:px-8">
    <div class="max-w-2xl" data-reveal-group>
      <p class="eyebrow mb-4 reveal">Maintainers</p>
      <h1 class="text-display font-light leading-[1.02] tracking-[-0.025em] reveal">The people behind Quoth.</h1>
    </div>

    <ul class="mt-16 grid gap-16" data-reveal-group>
      {people.map((p) => (
        <li class="reveal grid gap-8 sm:grid-cols-[10rem_1fr] sm:gap-12">
          <img src={p.image} alt={p.name} width="400" height="400" loading="lazy" class="h-40 w-40 rounded-2xl object-cover grayscale" />
          <div class="max-w-xl">
            <h2 class="text-2xl font-medium tracking-tight">{p.name}</h2>
            <p class="mt-1 text-sm text-ink-400">{p.role}</p>
            <p class="mt-5 leading-relaxed text-bone-dim">{p.bio}</p>
            <ul class="mt-6 flex gap-5">
              {p.socials.map((s) => (
                <li>
                  <a href={s.href} rel="noopener" aria-label={`${p.name} on ${s.label}`} class="block text-ink-400 transition-colors hover:text-bone">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-24 max-w-2xl border-t hairline pt-10" data-reveal-group>
      <h2 class="text-2xl font-medium tracking-tight reveal">Want to be on this page?</h2>
      <p class="mt-3 text-bone-dim reveal">
        Quoth needs people who care about a specific desktop, a language, or packaging for their distro. Pick an issue on GitHub, or open one saying what you would like to own.
      </p>
      <a class="btn btn-ghost mt-8 reveal" href="https://github.com/abullard1/quoth/issues" rel="noopener">Open issues</a>
    </div>
  </main>
  <Footer />
</Base>
